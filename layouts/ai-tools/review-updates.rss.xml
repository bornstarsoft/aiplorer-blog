{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Aiplorer AI Tool Change Watch</title>
    <link>{{ .Permalink }}</link>
    <description>Selected official AI tool announcements and practical checks. Publication dates are announcement dates, not Aiplorer review dates.</description>
    <language>en-us</language>
    <lastBuildDate>{{ time.Format "Mon, 02 Jan 2006 15:04:05 -0700" site.Data.ai_tool_changes.checkedAt }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml"/>
    {{ range partial "aiplorer-change-data.html" . }}
    <item>
      <title>{{ printf "%s: %s" .toolTitle .title }}</title>
      <link>{{ printf "ai-tools/review-updates/#change-%s" .id | absURL }}</link>
      <guid isPermaLink="false">{{ printf "aiplorer-change:%s:%v" .id .revision }}</guid>
      <pubDate>{{ time.Format "Mon, 02 Jan 2006 15:04:05 -0700" .announcedAt }}</pubDate>
      <category>{{ .topic }}</category>
      <description>{{ printf "%s Check before use: %s Official source: %s. Source checked by Aiplorer: %s." .summary .action .sourceUrl .checkedAt }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
